# Copy to backend/.env and fill in. Run with: uvicorn tandem.api:app --reload --env-file .env

# Meta Llama API key, reads feed screenshots. https://llama.developer.meta.com → API keys
LLAMA_API_KEY=
# Only if you use another OpenAI-compatible vision endpoint (Together, Groq, Ollama):
# LLAMA_BASE_URL=https://api.llama.com/compat/v1/
# LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Google OAuth web client id (same value as the frontend's VITE_GOOGLE_CLIENT_ID).
# https://console.cloud.google.com/apis/credentials → Create credentials → OAuth client ID → Web application
GOOGLE_CLIENT_ID=

# Any long random string; guards POST /admin/retrain. Make one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TANDEM_ADMIN_TOKEN=

# Local dev without Google: `Authorization: Bearer alice` signs in as "alice". NEVER set on Railway.
# TANDEM_DEV_AUTH=1
