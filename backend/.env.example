# Copy to backend/.env and fill in. Run with: uvicorn tandem.api:app --reload --env-file .env

# Meta Model API key, Muse Spark reads Explore screenshots. https://dev.meta.ai → API keys (US public preview)
MUSE_API_KEY=
# Defaults below. Use muse-spark-1.3-contributor for ~10x cheaper (Meta may train on your requests).
# MUSE_BASE_URL=https://api.meta.ai/v1
# MUSE_MODEL=muse-spark-1.3

# Any long random string; guards POST /admin/retrain. Make one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TANDEM_ADMIN_TOKEN=

# Local dev only: turns on the /dev preview routes. NEVER set in production.
# TANDEM_DEV_AUTH=1

# Opt into the existing automatic trainer for individual /training; off by default.
TANDEM_TRAINING_ENABLED=0
