# Copy to frontend/.env.local and fill in.

# Backend URL (Railway domain in production). Leave unset in dev: the dev server forwards /api to localhost:8000.
# VITE_API_URL=https://api.filmocracy.party
# Local dev: each phone tab gets its own user id, so one laptop can play a whole group.
VITE_DEV_AUTH=
# TMDB API Read Access Token, for posters and trailers by tmdb_id. https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=
