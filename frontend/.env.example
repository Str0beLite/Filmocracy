# Copy to frontend/.env.local and fill in.

# Backend URL (Railway domain in production).
VITE_API_URL=http://localhost:8000
# Same OAuth web client id as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
# TMDB API Read Access Token, for posters and trailers by tmdb_id. https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=
